{
  "name": "sentinelle-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=12288 next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:init": "tsx prisma/seed-init.ts",
    "db:reprise": "tsx scripts/reprise-sqlite.ts",
    "postinstall": "prisma generate",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "pnpm test && pnpm test:integration",
    "db:test": "prisma migrate deploy"
  },
  "dependencies": {
    "@azure/msal-node": "^3.6.3",
    "@better-auth/utils": "0.5.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "archiver": "^7.0.1",
    "better-auth": "^1.7.5",
    "chart.js": "^4.4.1",
    "exceljs": "^4.4.0",
    "ldapts": "^8.0.8",
    "mailparser": "3.7.5",
    "next": "^16.3.8",
    "nodemailer": "^10.0.14",
    "puppeteer": "^25.11.0",
    "qrcode": "1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/mailparser": "3.4.6",
    "@types/node": "^26.6.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "better-sqlite3": "^13.0.3",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22"
  }
}
