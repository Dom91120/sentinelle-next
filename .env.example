# ──────────────────────────────────────────────────────────
# Copie ce fichier en `.env` puis remplis les valeurs.
#   cp .env.example .env
# Ne commite JAMAIS le vrai .env (déjà dans .gitignore).
# ──────────────────────────────────────────────────────────

# Domaine public de l'app, servi par un reverse proxy TLS EXTERNE à la stack
# (l'app elle-même écoute en HTTP sur :3000).
APP_DOMAIN=localhost
# URL complète VUE PAR LES NAVIGATEURS (liens dans les e-mails, Better Auth).
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── PostgreSQL ──
POSTGRES_USER=sentinelle
POSTGRES_PASSWORD=change-moi-mot-de-passe-fort
POSTGRES_DB=sentinelle
# En Docker : construite dans docker-compose.yml. En dev local, décommente :
# DATABASE_URL=postgresql://sentinelle:change-moi-mot-de-passe-fort@localhost:5432/sentinelle?schema=public

# ── Better Auth ──
# Racine de tout ce que l'application chiffre ou signe (secrets TOTP, mots de passe
# SMTP / LDAP / O365, clés d'API, jeton O365). Génère : openssl rand -base64 32
BETTER_AUTH_SECRET=change-moi-secret-aleatoire
# Origines supplémentaires de confiance (anti-CSRF), séparées par des virgules.
# TRUSTED_ORIGINS=
# Cookie de session sans attribut Secure (test LAN en HTTP d'un build de prod).
# ALLOW_INSECURE_COOKIES=true

# ── Compte administrateur initial (db:init) ──
# Vide = mot de passe aléatoire affiché en console au premier démarrage.
# ADMIN_INITIAL_PASSWORD=
# ADMIN_EMAIL=admin@localhost

# ── Reprise de l'ancienne base SQLite (scripts/reprise-sqlite.ts) ──
# SECRET_KEY de l'application Flask : sert à déchiffrer les secrets Fernet de app_config.
# SENTINELLE_SECRET_KEY=
# SENTINELLE_SQLITE=../sentinelle/instance/admin_dashboard.db

# ── Cron ──
# Secret partagé entre le conteneur cron et les routes /api/cron. Génère : openssl rand -hex 24
CRON_SECRET=change-moi-cron-secret

# ── Sécurité (mêmes clés que l'application Flask) ──
SESSION_LIFETIME_MINUTES=480
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Imposer la double authentification aux comptes admin.
REQUIRE_2FA_ADMIN=false
# Faire confiance à X-Forwarded-For (uniquement derrière un reverse proxy de confiance).
TRUST_PROXY=false

# ── Replis .env des réglages gérés depuis Préférences (clés MANAGED, en base) ──
MAIL_ENABLED=true
MAIL_METHOD=smtp
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@localhost
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_TENANT_ID=
O365_SENDER_EMAIL=
O365_REDIRECT_URI=http://localhost:3000/auth/o365/callback
ALERT_RECIPIENTS=
REPORT_SCHEDULE=off
REPORT_RECIPIENTS=

# Authentification LDAP / Active Directory (cohabite avec les comptes locaux)
LDAP_ENABLED=false
LDAP_SERVER=ldap://dc.exemple.lan
LDAP_PORT=389
LDAP_USE_SSL=false
LDAP_VALIDATE_CERT=true
LDAP_CA_CERT=
LDAP_DOMAIN=exemple.lan
LDAP_BASE_DN=DC=exemple,DC=lan
LDAP_REQUIRED_GROUP=
LDAP_USER_DN_TEMPLATE=
LDAP_DEFAULT_ROLE=viewer
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=

# Seuils de statut (danger <=, attention <=, proche <=)
THRESHOLD_EXPIRY=7,15,30
THRESHOLD_DOMAIN=30,60,90
THRESHOLD_TASK=7,15,30
THRESHOLD_CONTRACT=60,90,180
THRESHOLD_WARRANTY=30,60,90
OS_STALE_DAYS=365

# Fonctionnalités (toutes modifiables depuis Préférences)
CT_MONITORING=true
SOFTWARE_ALERTS=true
QUOTES_ENABLED=true
GDPR_ENABLED=true
SOFTWARE_LINKS_ENABLED=true
CERTIFICATES_ENABLED=true
DOCUMENTS_ENABLED=true
DOCUMENT_MAX_MB=10
DOCUMENT_INLINE_VIEW=true
DASHBOARD_CUSTOM=true
PAGINATION_MEMORY=true
FICHE_NAVIGATION=true
SOFTWARE_FORM_LEGACY=false
CONTRACT_FORM_LEGACY=false
SUPPLIER_FORM_LEGACY=false
UI_PRIMARY_COLOR=

# Notifications par webhook (optionnel). Laisser vide pour désactiver.
TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Intégrations API (clés chiffrées en base de préférence)
SESAME_API_ENABLED=false
SESAME_API_TOKEN=
CHATIA_API_ENABLED=false
CHATIA_API_TOKEN=

# Ingestion des mails récapitulatifs de sauvegarde
BACKUP_INGEST_TOKEN=
BACKUP_INBOX_DIR=

# Sauvegarde automatique de la base (pg_dump quotidien à 01:00)
BACKUP_DB_DIR=
BACKUP_DB_KEEP=14
# pg_dump : celui du PATH par défaut. Sur un poste sans client PostgreSQL, celui du
# conteneur Docker, avec l'URL vue de l'intérieur du conteneur (port 5432) :
# PG_DUMP_BIN=docker exec sentinelle-pg pg_dump
# PG_DUMP_URL=postgresql://sentinelle:change-moi-mot-de-passe-fort@localhost:5432/sentinelle
